{
  "name": "randomatizer-web",
  "private": true,
  "version": "1.0",
  "description": "Minimalist self-hosted private open-source dice roller",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
